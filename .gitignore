.godot/
assets/

# Editor + scratch temp files (some were committed by accident; see audit)
*.tmp
/tmp_layout.json
/tmp_save.json
/nan_scan_tmp.gd
/nan_scan_tmp.gd.uid
# Regression run artifacts (regenerated each run)
tools/regression/out/

# Backups kept until operator sign-off (audit remediation)
*.bak
__pycache__/
*.bak_*

# A/B compare snapshots: verbatim copies of a whole source file at some past
# commit, used by src/scenes/world/MillCompareWorld.gd. Regenerated on demand
# with `git show <commit>:<path>` (see that file header) — never committed, or
# every grep of src/ would return a duplicate hit for every symbol in them.
src/tests/_catalog_pre_*.gd

# GDExtension load copies. On Windows the editor loads each extension library
# from a "~"-prefixed copy beside it, so the original stays replaceable (the
# harness's `== importing ==` step made these on 2026-09-25, byte-identical to
# the tracked DLLs). Recreated on every load; never commit them.
addons/**/~*.dll

# The Steam build's starting world: tools/steam/build_windows.sh copies the
# operator's user://world_layout.json here at export time. His data, not source.
/steam_seed/
