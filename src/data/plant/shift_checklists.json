    "procedure_nl": "Elke dienst controleren en invullen door de verantwoordelijke extruder operator en inleveren bij shiftleader->productie manager",
    "procedure_en": "Check and fill in every shift by the responsible extruder operator; hand in to shiftleader -> production manager",
    "columns_on_form": ["No.", "Parameter", "Parameter (guidance)", "Target or Range", "Actual (blank fill-in)"],
    "notes": "Every task frequency is 'elke dienst' (once per 8-hour shift) unless noted. 'target' holds the verbatim printed target; parsed numeric bounds in target_min/target_max where the target is a range, target_value where it is a single number. Highlights on FORM-008: red = critical, yellow = attention."
  },
  "line_1": [
    {"seq": 1, "task_nl": "Controleer: Extruder 1 afzuiging nr. 2 compactor", "task_en": "Check extruder 1 extraction (suction) nr. 2 compactor", "frequency": "elke dienst", "location": "lijn_1", "target": "40%", "target_value": 40, "target_min": null, "target_max": null, "unit": "%", "guidance_nl": "Hoger=folie naar buiten, lager=vocht", "guidance_en": "Higher = film blown outwards, lower = moisture", "notes": ""},
    {"seq": 2, "task_nl": "Controleer: Compactor temperatuur", "task_en": "Check compactor temperature", "frequency": "elke dienst", "location": "lijn_1", "target": "108 graden", "target_value": 108, "target_min": null, "target_max": null, "unit": "degC", "guidance_nl": "Hoger=kans op plastificatie", "guidance_en": "Higher = risk of plastification", "notes": ""},
    {"seq": 3, "task_nl": "Controleer: Vacuum zone temperatuur", "task_en": "Check vacuum zone temperature", "frequency": "elke dienst", "location": "lijn_1", "target": "160-165 graden", "target_value": null, "target_min": 160, "target_max": 165, "unit": "degC", "guidance_nl": "Anders=kans op vollopen vacuum", "guidance_en": "Otherwise = risk of vacuum zone flooding", "notes": ""},
    {"seq": 4, "task_nl": "Controleer: Laserfilter zone", "task_en": "Check laser filter zone (temperature)", "frequency": "elke dienst", "location": "lijn_1", "target": "165 graden", "target_value": 165, "target_min": null, "target_max": null, "unit": "degC", "guidance_nl": "", "guidance_en": "", "notes": "Guidance column blank on the form."},
    {"seq": 5, "task_nl": "Controleer: Bevulling MAS 1 en 2", "task_en": "Check filling level MAS 1 and 2", "frequency": "elke dienst", "location": "lijn_1", "target": "90%", "target_value": 90, "target_min": null, "target_max": null, "unit": "%", "guidance_nl": "Hoger=overbelasting", "guidance_en": "Higher = overload", "notes": "MAS = Austrian MAS extruder/dryer system; 'Bevulling' is a German loanword (filling)."},
    {"seq": 6, "task_nl": "Controleer: Entleering MAS 1 en 2", "task_en": "Check emptying level MAS 1 and 2", "frequency": "elke dienst", "location": "lijn_1", "target": "60%", "target_value": 60, "target_min": null, "target_max": null, "unit": "%", "guidance_nl": "Lager=lagere doorzet", "guidance_en": "Lower = lower throughput", "notes": "'Entleering' is a German loanword (emptying)."},
    {"seq": 7, "task_nl": "Controleer: Temperatur solwert DRD MAS", "task_en": "Check temperature setpoint DRD MAS", "frequency": "elke dienst", "location": "lijn_1", "target": "30-40 graden", "target_value": null, "target_min": 30, "target_max": 40, "unit": "degC", "guidance_nl": "Lager=meer kans op vocht", "guidance_en": "Lower = more risk of moisture", "notes": "'solwert' = German 'Sollwert' (setpoint); DRD = MAS dry-cleaning/dryer unit."},
    {"seq": 8, "task_nl": "Controleer: Heiz register MAS 1 en 2", "task_en": "Check heating register MAS 1 and 2", "frequency": "elke dienst", "location": "lijn_1", "target": "Ein", "target_value": null, "target_min": null, "target_max": null, "unit": null, "guidance_nl": "Uit=vocht", "guidance_en": "Off = moisture", "notes": "Target 'Ein' = German for ON."},
    {"seq": 9, "task_nl": "Controleer: Toerental shredder", "task_en": "Check shredder rotational speed", "frequency": "elke dienst", "location": "lijn_1", "target": "32-50 rpm", "target_value": null, "target_min": 32, "target_max": 50, "unit": "rpm", "guidance_nl": "Te laag=lagere doorzet", "guidance_en": "Too low = lower throughput", "notes": "Row does not say 'Lijn 5', assumed lijn 1 shredder — confirm with operator."},
    {"seq": 10, "task_nl": "Controleer: Lijn 5 maalmolen", "task_en": "Check line 5 grinding mill (motor current)", "frequency": "elke dienst", "location": "lijn_5", "target": "130-270 Amp", "target_value": null, "target_min": 130, "target_max": 270, "unit": "A", "guidance_nl": "Te laag=lagere doorzet", "guidance_en": "Too low = lower throughput", "notes": ""},
    {"seq": 11, "task_nl": "Controleer: Lijn 5 V10 aflaat tijd klep", "task_en": "Check line 5 V10 drain valve time", "frequency": "elke dienst", "location": "lijn_5", "target": "Automaat", "target_value": null, "target_min": null, "target_max": null, "unit": null, "guidance_nl": "In hand loopt V10 vol zand", "guidance_en": "In manual mode V10 fills up with sand", "notes": "V10 = vessel/tank designation on lijn 5."},
    {"seq": 12, "task_nl": "Controleer: Lijn 5 V10 puls tijd klep", "task_en": "Check line 5 V10 valve pulse time", "frequency": "elke dienst", "location": "lijn_5", "target": "5 sec", "target_value": 5, "target_min": null, "target_max": null, "unit": "s", "guidance_nl": "lagere setting=v10 vol zand", "guidance_en": "Lower setting = V10 full of sand", "notes": ""},
    {"seq": 13, "task_nl": "Controleer: Lijn 5 V10 pauze tijd", "task_en": "Check line 5 V10 pause time", "frequency": "elke dienst", "location": "lijn_5", "target": "45 sec", "target_value": 45, "target_min": null, "target_max": null, "unit": "s", "guidance_nl": "Hogere setting=V10 vol zand", "guidance_en": "Higher setting = V10 full of sand", "notes": ""},
    {"seq": 14, "task_nl": "Controleer: Lijn 5 shredder vul niveau", "task_en": "Check line 5 shredder fill level", "frequency": "elke dienst", "location": "lijn_5", "target": "15-25 cm", "target_value": null, "target_min": 15, "target_max": 25, "unit": "cm", "guidance_nl": "Hoger=brugvorming", "guidance_en": "Higher = bridging", "notes": ""},
    {"seq": 15, "task_nl": "Controleer: Lijn 5 shredder looptijd", "task_en": "Check line 5 shredder run time", "frequency": "elke dienst", "location": "lijn_5", "target": "4 sec", "target_value": 4, "target_min": null, "target_max": null, "unit": "s", "guidance_nl": "langer=slierten", "guidance_en": "Longer = strands/stringers", "notes": ""},
    {"seq": 16, "task_nl": "Controleer: Lijn 5 shredder pauzetijd", "task_en": "Check line 5 shredder pause time", "frequency": "elke dienst", "location": "lijn_5", "target": "1 sec", "target_value": 1, "target_min": null, "target_max": null, "unit": "s", "guidance_nl": "korter=stop, langer=output verlies", "guidance_en": "Shorter = stop, longer = output loss", "notes": ""},
    {"seq": 17, "task_nl": "Controleer: Lijn 5 DSD schroef", "task_en": "Check line 5 DSD screw", "frequency": "elke dienst", "location": "lijn_5", "target": "15%", "target_value": 15, "target_min": null, "target_max": null, "unit": "%", "guidance_nl": "Uit=meer kosten, te hoog=afkeur/voc[ht]", "guidance_en": "Off = more cost, too high = rejects/moisture", "notes": "[unsure: guidance text cut off at cell edge after 'voc', almost certainly 'vocht']. DSD = Duales System Deutschland post-consumer material."},
    {"seq": 18, "task_nl": "Controleer: Lijn 5 extruder schroef", "task_en": "Check line 5 extruder screw speed", "frequency": "elke dienst", "location": "lijn_5", "target": "50-70 rpm", "target_value": null, "target_min": 50, "target_max": 70, "unit": "rpm", "guidance_nl": "Te hoog=meer kans op gasvorming", "guidance_en": "Too high = more risk of gas formation", "notes": ""},
    {"seq": 19, "task_nl": "Controleer: Lijn 5 persschroef", "task_en": "Check line 5 press screw", "frequency": "elke dienst", "location": "lijn_5", "target": "100%", "target_value": 100, "target_min": null, "target_max": null, "unit": "%", "guidance_nl": "Lager=lagere doorzet", "guidance_en": "Lower = lower throughput", "notes": ""},
    {"seq": 20, "task_nl": "Controleer: Lijn 5 vacuum", "task_en": "Check line 5 vacuum", "frequency": "elke dienst", "location": "lijn_5", "target": "minus 0,7-0,9 bar", "target_value": null, "target_min": -0.9, "target_max": -0.7, "unit": "bar", "guidance_nl": "Minder=meer gasvorming", "guidance_en": "Less (vacuum) = more gas formation", "notes": "Printed as 'minus 0,7-0,9 bar' (i.e. -0.7 to -0.9 bar gauge)."}
  ],
