[gd_resource type="Resource" script_class="MachineSoundSpec" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/audio/MachineSoundSpec.gd" id="1_spec"]

[resource]
script = ExtResource("1_spec")
gain_db = 3.0
unit_size_m = 4.0
max_distance_m = 35.0
run_loop = "res://assets/audio/machines/compactor_ringleiding_loop.wav"
pitch_floor = 1.0
ramp_db_floor = -18.0
notes = "Compactor / PCU — the 'automatic ringleiding cleaning' recording (loop_3x_1m11s-1m14s_…, 2026-09-22). Operator 2026-09-25, verbatim: take 1:11-1:14, 'then it does twice more from 1 minute 11 s to 1 minute 14 s, and then that entire sound of the three, in a sequence, has to loop'. So the 3x sequence (8.91 s: three air pulses 2.97 s apart on the compressor bed) is this machine's RUN LOOP and plays for as long as LineFlow drives the compactor. It is the compactor's only recording; there is no separate motor loop. pitch_floor is 1.0 on purpose: air pulses do not pitch-bend with motor speed, so the generated ramp is level-only (ramp_db_floor). An earlier bake fired the sequence as a one-shot every 90 s — that period was invented, nothing in the plant docs gives one (EREMA GUIDE 355_CeDo59 describes the air flush, no interval), and it is gone; if the operator later wants the flush periodic, periodic_event/periodic_event_s are the knobs. Level (gain_db), attenuation radii and ramp_db_floor are PLACEHOLDERS chosen by ear-less reasoning on 2026-09-25 — tune them in this inspector after play-testing. Baked by tools/audio/machine_clips.py from assets/audio/machines/_source/, RMS-normalised to -20 dBFS so gain_db is the only relative level."
