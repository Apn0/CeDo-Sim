[gd_resource type="Resource" script_class="MachineSoundSpec" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/audio/MachineSoundSpec.gd" id="1_spec"]

[resource]
script = ExtResource("1_spec")
gain_db = 2.0
unit_size_m = 1.5
max_distance_m = 25.0
run_loop = "res://assets/audio/machines/leafblower_rev.wav"
idle_loop = "res://assets/audio/machines/leafblower_idle.wav"
start_clip = "res://assets/audio/machines/leafblower_start.wav"
stop_clip = "res://assets/audio/machines/leafblower_stop.wav"
pitch_floor = 0.85
ramp_db_floor = 0.0
idle_to_run_at = 0.2
idle_pitch_top = 1.3
notes = "Two-stroke leaf blower. Source leaf_blower_starter_idle_revving.mp3 split into: start (0-1.3 s pull + catch), idle loop (6-17.2 s, steady 248 Hz), rev loop (2.3-5.65 s, throttle worked) and stop (17.35-20.1 s, engine dying). Drive = LeafBlower._spool: idle below idle_to_run_at, equal-power crossfade to the rev loop above it, idle pitched up to idle_pitch_top at full throttle. Level (gain_db), attenuation radii, pitch_floor and the ramp times are PLACEHOLDERS chosen by ear-less reasoning on 2026-09-25 — tune them in this inspector after play-testing. The clip is the operator's own recording of 2026-09-22 (assets/audio/machines/_source/), baked by tools/audio/machine_clips.py, RMS-normalised to -20 dBFS so gain_db is the only relative level."
