## Vertical wooden mounting posts (worker_outfit.png shows the worker beside
## these — they're oiled mid-brown structural posts that hold valves / pipes
## in the wash line). Distinct from timber_dark which is the heavy arch beams.
static func mat_timber_post() -> StandardMaterial3D:
	return _lazy("timber_post", Color(0.42, 0.30, 0.20), 0.0, 0.85)


