extends Object
class_name MaterialPalette

## Cached singleton StandardMaterial3D palette, derived from reference photos of
## the real CeDo halls. Every getter returns the SAME instance every call, so a
## hundred meshes sharing one material cost one material in VRAM.
##
## Naming convention: `mat_<category>_<descriptor>()`. Categories so far:
##   concrete  — floor / slab variants (worn, wet, oily, dirt buildup)
##   paint     — safety paint stripes, equipment paint
##   timber    — heavy structural wood + crate wood
##   steel     — raw / galvanised / aged / riveted, including pipes
##   light     — emissive: fluorescent / LED / sodium
##
## Add new entries here in the category they belong to, NOT scattered through
## per-builder _mat() calls — one place to tune the whole look later.

# ── internal: lazy-build + cache ──────────────────────────────────────────────
static var _cache : Dictionary = {}

## Photo-extracted texture triplets live under gitignored assets/textures/
## (generated by tools/extract_texture_atlas.py from the operator reference
## photos). When the PNGs are absent — public clone without local assets —
## every entry falls back to its calibrated flat color below.
const _TEX_DIR : String = "res://assets/textures/"

## NB: name `_lazy` not `_get` — `_get` collides with Godot's Object._get() virtual.
static func _lazy(key: String, color: Color, metallic: float, roughness: float,
				 emission: Color = Color(0, 0, 0, 0), emission_energy: float = 0.0,
				 cull_disabled: bool = false,
				 tex_base: String = "", tex_tile_m: float = 2.0) -> StandardMaterial3D:
	if _cache.has(key):
		return _cache[key]
	var m := StandardMaterial3D.new()
	m.albedo_color = color
	m.metallic = metallic
	m.roughness = roughness
	if emission_energy > 0.0:
		m.emission_enabled = true
		m.emission = emission
		m.emission_energy_multiplier = emission_energy
	if cull_disabled:
		m.cull_mode = BaseMaterial3D.CULL_DISABLED
	if tex_base != "":
		_apply_tex(m, tex_base, tex_tile_m)
	_cache[key] = m
	return m

## Mount a photo-extracted albedo/normal/roughness triplet onto `m` if the
## files exist. Triplanar (object-space) so procedural meshes without UV
## unwraps tile correctly; `tile_m` is the real-world size in metres the
## extracted patch covers, so detail density matches the photos.
static func _apply_tex(m: StandardMaterial3D, base: String, tile_m: float) -> void:
	var albedo_path := _TEX_DIR + base + "_albedo.png"
	if not ResourceLoader.exists(albedo_path):
		return
	m.albedo_texture = load(albedo_path)
	# The extracted albedo already carries the photo-calibrated color —
	# leaving the flat color in place would double-tint it.
	m.albedo_color = Color.WHITE
	var normal_path := _TEX_DIR + base + "_normal.png"
	if ResourceLoader.exists(normal_path):
		m.normal_enabled = true
		m.normal_texture = load(normal_path)
		m.normal_scale = 0.6
	var rough_path := _TEX_DIR + base + "_rough.png"
	if ResourceLoader.exists(rough_path):
		m.roughness_texture = load(rough_path)
	m.uv1_triplanar = true
	m.uv1_scale = Vector3.ONE / maxf(tile_m, 0.01)


# ── FLOOR / CONCRETE ─────────────────────────────────────────────────────────
## Photo-calibrated values from assets/reference_photos/building/hal_0_*.png
## and yellow_ladders_railings_lines.png. The hall floor is a warm-grey-brown
## worn concrete, NOT neutral grey — calibrated darker than the previous
## placeholder (0.55, 0.55, 0.55) to match the actual hall.
static func mat_concrete_worn() -> StandardMaterial3D:
	return _lazy("concrete_worn", Color(0.36, 0.34, 0.31), 0.0, 0.88,
		Color(0, 0, 0, 0), 0.0, false, "floor/concrete_worn", 2.5)

## Wet streak / shallow puddle — darker + far less rough so the lights reflect.
## Use for puddle patches over concrete, not as a fill colour.
## Photo: yellow_ladders_railings_lines.png shows large dark wet patches with
## faint highlights — a tan-brown reflective sheen.
static func mat_concrete_wet() -> StandardMaterial3D:
	return _lazy("concrete_wet", Color(0.24, 0.22, 0.20), 0.0, 0.22)

## Oil / grease spill — near-black, slightly glossy. Visible in hal_0 photo as
## dark trickling stains across the floor.
static func mat_oil_grease() -> StandardMaterial3D:
	return _lazy("oil_grease", Color(0.10, 0.09, 0.08), 0.0, 0.40)

## Dirt / fine-dust buildup at wall bases and column feet. Photo-cal from
## hal_0 corners showing dried mud + dust caked on the floor edge.
static func mat_dirt_buildup() -> StandardMaterial3D:
	return _lazy("dirt_buildup", Color(0.32, 0.28, 0.22), 0.0, 0.97,
		Color(0, 0, 0, 0), 0.0, false, "floor/dirt_buildup", 2.0)


# ── PAINT (safety stripes + equipment) ──────────────────────────────────────
## Worn yellow safety-stripe paint on the floor — faded, chipped, very matte.
## Photo: yellow_ladders_railings_lines.png floor stripes — desaturated warm
## yellow that's clearly years of foot traffic on top of bright safety paint.
static func mat_paint_safety_yellow_worn() -> StandardMaterial3D:
	return _lazy("paint_safety_yellow_worn", Color(0.78, 0.66, 0.18), 0.0, 0.88)

## Fresh / equipment yellow — guardrails, lighthouse beacons, gantry frames.
## Photo: yellow_ladders_railings_lines.png upper-deck handrails. Bright but
## with a slight green-yellow lean, not pure CMYK yellow.
static func mat_paint_safety_yellow() -> StandardMaterial3D:
	return _lazy("paint_safety_yellow", Color(0.94, 0.78, 0.14), 0.0, 0.60)


# ── TIMBER (heavy structural + crate wood) ──────────────────────────────────
## Heavy dark structural timber — the wooden archways / columns / roof trusses
## visible in hal 0 + wooden V-shape support beams. Vertical grain,
## weather-checked, near-matte. Photo: hal_0 archway, V-shape beams.
## Calibrated WARMER and slightly lighter than the previous (0.18,0.13,0.09)
## placeholder — the real timber reads as oiled medium-dark brown not near-black.
static func mat_timber_dark() -> StandardMaterial3D:
	return _lazy("timber_dark", Color(0.30, 0.22, 0.14), 0.0, 0.92,
		Color(0, 0, 0, 0), 0.0, false, "building/timber_dark", 1.2)

## Dark wooden ceiling-deck planks (above the timber arches).
static func mat_wood_deck_dark() -> StandardMaterial3D:
	return _lazy("wood_deck_dark", Color(0.24, 0.18, 0.12), 0.0, 0.92)

## Natural pine packing crates — light tan, matte.
static func mat_wood_crate_pine() -> StandardMaterial3D:
