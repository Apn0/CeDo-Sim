## oxidation. Use for big wash drums + tank exteriors that have been in service.
## Photo: flotatietank_3A.png shows the tank as a much darker, dirtier
## stainless than a clean factory finish — heavy rust streaking + grime.
static func mat_stainless_weathered() -> StandardMaterial3D:
	return _lazy("stainless_weathered", Color(0.50, 0.48, 0.45), 0.50, 0.65,
		Color(0, 0, 0, 0), 0.0, false, "machines/stainless_weathered", 1.5)

## Dark recessed text effect on stainless (capacity placards, equipment ids).
