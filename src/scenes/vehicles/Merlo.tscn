[gd_scene format=3 uid="uid://bmerlo00001a"]

; Merlo compact telehandler ("far reacher") — rebuilt from the operator's photos.
; Signature features captured: glassy cab on the LEFT, FOPS slat cage guarding the
; windscreen, boom down the RIGHT side with a lift cylinder, green wheel rims on fat
; tyres, a roof beacon, and the ribbed grapple bucket up front. Node paths the
; Merlo.gd script drives are unchanged:
;   BoomPivot / BoomPivot/BoomExtend / .../BucketTilt / .../GrappleArm / .../CarryPoint
;   CabCamera, EnterArea.

[ext_resource type="Script" path="res://src/scenes/vehicles/Merlo.gd" id="1_merlo"]
[ext_resource type="Script" path="res://src/scenes/vehicles/VehicleEnterArea.gd" id="2_enter"]

