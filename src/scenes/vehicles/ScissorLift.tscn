[gd_scene format=3 uid="uid://dudbhudo6vqa7"]

; JLG Toucan-style electric VERTICAL MAST lift — rebuilt from the operator's photos
; (the plant ran three). Legacy node names (ScissorLift, Platform, CabCamera) are
; kept so saves / HUD / map keep resolving; the mechanism is now a nested
; telescoping mast, not scissor arms. Mast stages are Mast/Stage1..Stage3
; (animated by ScissorLift.gd). Rear = rounded red battery/drive cowl.

[ext_resource type="Script" path="res://src/scenes/vehicles/ScissorLift.gd" id="1_sl"]
[ext_resource type="Script" path="res://src/scenes/vehicles/VehicleEnterArea.gd" id="2_enter"]

; ── Chassis + base ────────────────────────────────────────────────────────────
[sub_resource type="BoxShape3D" id="Shape_chassis"]
size = Vector3(1.5, 0.55, 2.4)

[sub_resource type="BoxMesh" id="Mesh_chassis"]
size = Vector3(1.5, 0.5, 2.4)

[sub_resource type="BoxMesh" id="Mesh_skirt"]
size = Vector3(1.56, 0.22, 2.46)

; Rounded battery/drive cowl at the rear (the red fibreglass hump in the photos).
[sub_resource type="CapsuleMesh" id="Mesh_cowl"]
