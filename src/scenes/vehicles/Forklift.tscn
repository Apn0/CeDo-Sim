; ── Materials ────────────────────────────────────────────────────────────────
; LIVERY BODY COLOUR (#184): dark industrial green (task #39's intent), MATTE so it
; reads as solid paint instead of the old washed-out cream that looked white in-game.
; To match the real CeDo machine, change Mat_yellow + Mat_hood albedo here — it is a
; one-line swap. (Reference photos weren't in the project, so this is the stopgap.)
[sub_resource type="StandardMaterial3D" id="Mat_yellow"]
albedo_color = Color(0.13, 0.30, 0.17, 1)
metallic = 0.0
roughness = 0.78

[sub_resource type="StandardMaterial3D" id="Mat_hood"]
albedo_color = Color(0.10, 0.23, 0.13, 1)
metallic = 0.0
roughness = 0.62

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
albedo_color = Color(0.15, 0.15, 0.15, 1)
roughness = 0.8

[sub_resource type="StandardMaterial3D" id="Mat_seat"]
albedo_color = Color(0.09, 0.09, 0.10, 1)
roughness = 0.95

[sub_resource type="StandardMaterial3D" id="Mat_chrome"]
albedo_color = Color(0.78, 0.80, 0.82, 1)
metallic = 0.85
roughness = 0.20

[sub_resource type="StandardMaterial3D" id="Mat_lpg"]
albedo_color = Color(0.78, 0.18, 0.14, 1)
roughness = 0.55

[sub_resource type="StandardMaterial3D" id="Mat_sticker"]
albedo_color = Color(0.85, 0.10, 0.10, 1)
roughness = 0.30
emission_enabled = true
emission = Color(0.5, 0.05, 0.05, 1)
emission_energy_multiplier = 0.4

; #95 — Cab glass: front windshield + rear window between the ROPS posts. Real
; industrial forklifts often skip side glass for operator ingress; we follow
; that convention. Slight blue tint, high metallic + low roughness so it reads
; as glass instead of plastic. ALPHA transparency means it draws AFTER opaque
; geometry — the operator can still see the dashboard / seat through it.
[sub_resource type="StandardMaterial3D" id="Mat_glass"]
albedo_color = Color(0.55, 0.70, 0.78, 0.32)
metallic = 0.85
roughness = 0.05
transparency = 1
cull_mode = 2

[sub_resource type="BoxMesh" id="BoxMesh_glass_fr"]
size = Vector3(1.04, 1.04, 0.018)
[sub_resource type="BoxMesh" id="BoxMesh_glass_side"]
size = Vector3(0.018, 1.04, 1.82)

; #95-fix — Thin BoxShape3D for the windshields so the player + dropped tools
; can't walk / fall through them. Box is slightly thinner than the mesh so it
; doesn't shadow the visible glass at grazing angles.
[sub_resource type="BoxShape3D" id="BoxShape_glass_fr"]
size = Vector3(1.04, 1.04, 0.030)

; #95-fix — Aluminium frame around the windshields (#96 style: aluminium rail
; running the perimeter of the glass pane). Four thin bars per panel.
[sub_resource type="BoxMesh" id="BoxMesh_frame_h"]
size = Vector3(1.08, 0.035, 0.035)
[sub_resource type="BoxMesh" id="BoxMesh_frame_v"]
size = Vector3(0.035, 1.04, 0.035)

[sub_resource type="StandardMaterial3D" id="Mat_alu_frame"]
albedo_color = Color(0.72, 0.74, 0.78, 1)
metallic = 0.85
roughness = 0.32

; #95 side glass + doors (operator-confirmed: glass front+left+right+rear, doors
; that open). Doors are hinged via a Node3D pivot at the FRONT post so they can
