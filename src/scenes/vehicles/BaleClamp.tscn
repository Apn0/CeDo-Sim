; ── Counterweight (rear) + LPG cylinder strapped on top ──────────────────────
[node name="Counterweight" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.65, -1.55)
mesh = SubResource("BoxMesh_counterweight")
material_override = SubResource("Mat_dark")

; BaleClamp carries TWO LPG cylinders side-by-side on the counterweight.
; H switches the active feed between LPG_Mount_0 (left) and LPG_Mount_1 (right).
; Both lie horizontal with the valve facing forward.
; Tanks lie along Z (valve to the FRONT), side by side at x=±0.28 so they sit on
; the counterweight WITHOUT protruding past the body sides (#14 — they used to lie
; along X at ±0.42 × 0.95 m long, sticking out to ±0.9 and overlapping in the middle).
[node name="LPG_Mount_0" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, -0.28, 1.18, -1.55)

[node name="LPG_Mount_1" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0.28, 1.18, -1.55)

