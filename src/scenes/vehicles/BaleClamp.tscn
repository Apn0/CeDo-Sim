; ── Materials ────────────────────────────────────────────────────────────────
; LIVERY BODY COLOUR (#184): dark industrial green (task #39's intent), MATTE so it
; reads as solid paint instead of the old washed-out cream that looked white in-game.
; Mat_orange keeps its legacy id but is the body green now. Change Mat_orange +
; Mat_hood albedo to match the real CeDo photo when available — one-line swap.
[sub_resource type="StandardMaterial3D" id="Mat_orange"]
albedo_color = Color(0.13, 0.30, 0.17, 1)
metallic = 0.0
roughness = 0.78

[sub_resource type="StandardMaterial3D" id="Mat_hood"]
albedo_color = Color(0.10, 0.23, 0.13, 1)
metallic = 0.0
roughness = 0.62

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
albedo_color = Color(0.15, 0.15, 0.15, 1)
roughness = 0.8

[sub_resource type="StandardMaterial3D" id="Mat_seat"]
albedo_color = Color(0.09, 0.09, 0.10, 1)
roughness = 0.95

[sub_resource type="StandardMaterial3D" id="Mat_chrome"]
albedo_color = Color(0.78, 0.80, 0.82, 1)
metallic = 0.85
roughness = 0.20

[sub_resource type="StandardMaterial3D" id="Mat_lpg"]
albedo_color = Color(0.78, 0.18, 0.14, 1)
roughness = 0.55

; #169 — was bright red emission ON THE FRONT, which the operator read as a
; "reverse" or "danger" indicator and triggered the "feels like driving
; backwards" confusion. Re-purposed as a neutral white badge.
[sub_resource type="StandardMaterial3D" id="Mat_sticker"]
albedo_color = Color(0.92, 0.92, 0.92, 1)
roughness = 0.45

; #169 — Headlight (white, FRONT), taillight (red, REAR). Emission on so they
; read as lights at a glance.
[sub_resource type="StandardMaterial3D" id="Mat_headlight"]
albedo_color = Color(0.98, 0.96, 0.85, 1)
roughness = 0.20
emission_enabled = true
emission = Color(1.0, 0.96, 0.80, 1)
emission_energy_multiplier = 0.9

[sub_resource type="StandardMaterial3D" id="Mat_taillight"]
albedo_color = Color(0.85, 0.10, 0.10, 1)
roughness = 0.30
emission_enabled = true
emission = Color(0.85, 0.05, 0.05, 1)
emission_energy_multiplier = 0.7

