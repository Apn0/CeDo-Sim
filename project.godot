; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="CeDo Simulator"
config/description="A 1:1 real-time shift simulator for LDPE plastic film recycling operations at CeDo Geleen."
config/version="0.1.0"
run/main_scene="res://src/scenes/menus/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://cedo_logo.svg"
run/max_log_files=20

[audio]

buses/default_bus_layout="uid://ufjffcjjbpd5"
driver/enable_input=true

[autoload]

EventBus="*res://src/autoload/EventBus.gd"
ScanLog="*res://src/autoload/ScanLog.gd"
SimTick="*res://src/autoload/SimTick.gd"
SettingsManager="*res://src/autoload/SettingsManager.gd"
AudioManager="*res://src/autoload/AudioManager.gd"
Walkie="*res://src/autoload/Walkie.gd"
Inventory="*res://src/autoload/Inventory.gd"
WorldLayout="*res://src/autoload/WorldLayout.gd"
SubtitleHud="*res://src/autoload/SubtitleHud.gd"
AirNetwork="*res://src/autoload/AirNetwork.gd"
NaNSentinel="*res://src/autoload/NaNSentinel.gd"
ApiKeys="*res://src/autoload/ApiKeys.gd"
VoiceService="*res://src/autoload/VoiceService.gd"
LineMacroStore="*res://src/autoload/LineMacroStore.gd"
NpcAutonomyBoard="*res://src/autoload/NpcAutonomyBoard.gd"
HotspotProfiler="*res://src/autoload/HotspotProfiler.gd"
Plant="*res://src/autoload/Plant.gd"
TextureCache="*res://src/autoload/TextureCache.gd"
PolyhavenMaterials="*res://src/autoload/PolyhavenMaterials.gd"
AeroUnits="*uid://5vah4ayrdxci"

[debug]

gdscript/warnings/unused_signal=0
shader_language/warnings/treat_warnings_as_errors=true
gdscript/warnings/unused_argument=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_aerodynamic_physics/plugin.cfg", "res://addons/waterbox/plugin.cfg")

